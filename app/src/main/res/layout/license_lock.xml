<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in place of the keys when the pro build has no activated license. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F0F4F8"
    android:gravity="center_horizontal"
    android:minHeight="220dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="LD Keyboard ยังไม่ได้เปิดใช้งาน"
        android:textColor="#1A237E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:text="กรุณากรอก License Key ในแอป LD Keyboard ก่อนใช้งาน"
        android:textColor="#333333"
        android:textSize="14sp" />

    <Button
        android:id="@+id/lockActivateBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="#1565C0"
        android:text="เปิดใช้งาน License"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <Button
        android:id="@+id/lockSwitchImeBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#FFFFFF"
        android:text="เปลี่ยนคีย์บอร์ด"
        android:textColor="#1565C0"
        android:textSize="15sp" />
</LinearLayout>
