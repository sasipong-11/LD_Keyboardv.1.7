<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10sp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/sequence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5sp"
            android:text="No."
            android:textColor="@android:color/black"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/wordTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="21sp"
            android:text="Word"
            android:textColor="@android:color/black"
            android:textSize="27sp" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp">

        <TextView
            android:id="@+id/thaiHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22sp"
            android:text="Thai - Thai"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="27sp"  />
        <ImageButton
            android:id="@+id/speakThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="90sp"
            android:background="@android:color/transparent"
            android:padding="5sp"
            android:src="@drawable/speaker_small" />

        <TextView
            android:id="@+id/thaiTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="138sp"
            android:lineSpacingExtra="10dp"
            android:text="Thai Meaning"
            android:textColor="@android:color/black"
            android:textSize="27sp" />


    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <TextView
            android:id="@+id/englishHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22sp"
            android:text="Thai - English"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="27sp" />
        <ImageButton
            android:id="@+id/speakEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="90sp"
            android:background="@android:color/transparent"
            android:padding="5sp"
            android:src="@drawable/speaker_small" />
        <TextView
            android:id="@+id/engTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="138sp"
            android:text="English Meaning"
            android:textColor="@android:color/black"
            android:textIsSelectable="false"
            android:textSize="27sp"
            android:lineSpacingExtra="10dp"/>



    </FrameLayout>

</LinearLayout>