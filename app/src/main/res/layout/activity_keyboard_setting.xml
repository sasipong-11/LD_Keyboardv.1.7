<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_blue"
    android:padding="10dp"
    tools:context="th.or.nectec.twskeyboard.KeyboardSettingActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/headSelectBg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="เลือกภาพพื้นหลัง"
                android:textColor="#000000"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/themeBgImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:adjustViewBounds="false"
                android:background="@color/blueBg"
                android:baselineAlignBottom="false"
                android:padding="8dp" />

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/basicThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" ไม่ใส่ภาพพื้นหลัง"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/monkeyThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้ชายกับลิงน้อย"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/jumpThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้หญิงกระโดดเชือก"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/templeThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" สุนัขกับแมว"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/fishThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" ปลาหมึกกับปลาการ์ตูน"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/dollThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้หญิงเล่นตุ๊กตา"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/parrotThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้หญิงกับนกแก้ว"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/catThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้หญิงเล่นกับแมว"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/horseThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้ชายกับม้า"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/goldfishThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้ชายกับปลาทอง"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/dolphinThemeRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:text=" เด็กผู้ชายกับปลาโลมา"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

            </RadioGroup>

            <TextView
                android:id="@+id/headSelectSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ปรับขนาดตัวอักษร"
                android:textColor="#000000"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/keySeekBarProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text=""
                android:textColor="#000000"
                android:textSize="15sp"
                android:layout_centerInParent="true"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/keyTextSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="50" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginBottom="25dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <!-- <RelativeLayout
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:paddingRight="6dp">-->

                    <TextView
                        android:id="@+id/keyThai1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="ก ข ฃ ค ฅ ฆ ง จ"
                        android:textColor="@color/black" />
                    <!-- </RelativeLayout>-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/keyEng1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="a b c d e f g h"
                        android:textColor="@color/black" />


                </LinearLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/headSelectVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="สั่นเมื่อกดปุ่ม"
                android:textColor="#000000"
                android:textSize="30sp" />

            <RadioGroup
                android:id="@+id/beepRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/beepOffRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:checked="false"
                    android:text="ปิด"
                    android:textColor="@color/black"
                    android:textSize="27sp" />

                <RadioButton
                    android:id="@+id/beepOnRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:checked="true"
                    android:text="เปิด"
                    android:textColor="@color/black"
                    android:textSize="27sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/versionHeadTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:text="Version ที่ใช้งาน"
                android:textColor="#000000"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/versionDetailTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginBottom="25dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical|center_horizontal|center"
                android:text="LD Keyboard version 1.7"
                android:textColor="#000000"
                android:textSize="27sp" />

            <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:backgroundTint="#438696"
                    android:text="เลือกคีย์บอร์ด"
                    android:textColor="#ffffff"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/manualBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:backgroundTint="#438696"
                    android:text="คู่มือการใช้งาน"
                    android:textColor="#ffffff"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
