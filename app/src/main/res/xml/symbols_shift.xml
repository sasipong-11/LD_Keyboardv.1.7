<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:horizontalGap="@dimen/horizontalGap"
    android:verticalGap="@dimen/verticalGap"
    android:keyHeight="@dimen/key_height">

    <Row>
        <Key android:codes="91" android:keyLabel="[" android:keyWidth="11.375%p" android:keyEdgeFlags="left"/>
        <Key android:codes="93" android:keyLabel="]" android:keyWidth="11.375%p"/>
        <Key android:codes="123" android:keyLabel="{" android:keyWidth="11.375%p"/>
        <Key android:codes="125" android:keyLabel="}" android:keyWidth="11.375%p"/>
        <Key android:codes="40" android:keyLabel="(" android:keyWidth="11.375%p"/>
        <Key android:codes="41" android:keyLabel=")" android:keyWidth="11.375%p"/>
        <Key android:codes="95" android:keyLabel="_" android:keyWidth="11.375%p"/>
        <Key android:codes="35" android:keyLabel="\#" android:keyWidth="11.375%p" android:keyEdgeFlags="right"/>
    </Row>

    <Row>
        <Key android:codes="124" android:keyLabel="|" android:keyWidth="11.375%p" android:keyEdgeFlags="left"/>
        <Key android:codes="92" android:keyLabel="\\" android:keyWidth="11.375%p"/>
        <Key android:codes="126" android:keyLabel="~" android:keyWidth="11.375%p"/>
        <Key android:codes="8226" android:keyLabel="•" android:keyWidth="11.375%p"/>
        <Key android:codes="96" android:keyLabel="`" android:keyWidth="11.375%p"/>
        <Key android:codes="8364" android:keyLabel="€"  android:keyWidth="11.375%p"/>
        <Key android:codes="64" android:keyLabel="\@" android:keyWidth="11.375%p"/>
        <Key android:codes="36" android:keyLabel="$" android:keyWidth="11.375%p" android:keyEdgeFlags="right"/>
        <!--<Key android:codes="165" android:keyLabel="¥" android:keyWidth="10%p"/>
        <Key android:codes="163" android:keyLabel="£" android:keyWidth="10%p"/>
        <Key android:codes="162" android:keyLabel="¢" android:keyWidth="10%p"/>-->
    </Row>

    <Row>
        <Key android:codes="94" android:keyLabel="^" android:keyWidth="11.375%p" android:keyEdgeFlags="left"/>
        <!--<Key android:codes="960" android:keyLabel="π" android:keyWidth="10%p"/>
        <Key android:codes="8730" android:keyLabel="√" android:keyWidth="10%p"/>
        <Key android:codes="174" android:keyLabel="®" android:keyWidth="10%p"/>
        <Key android:codes="169" android:keyLabel="©" android:keyWidth="10%p"/>
        <Key android:codes="8482" android:keyLabel="™" android:keyWidth="10%p"/>-->
        <Key android:codes="39" android:keyLabel="\'" android:keyWidth="11.375%p"/>
        <Key android:codes="34" android:keyLabel="&quot;" android:keyWidth="11.375%p"/>
        <Key android:codes="58" android:keyLabel=":" android:keyWidth="11.375%p"/>
        <Key android:codes="59" android:keyLabel=";" android:keyWidth="11.375%p"/>
        <Key android:codes="33" android:keyLabel="!" android:keyWidth="11.375%p"/>
        <Key android:codes="-5" android:keyIcon="@drawable/ic_del" android:keyWidth="23.75%p"
            android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-101" android:keyIcon="@drawable/ic_language" android:keyWidth="13%p"
            android:keyEdgeFlags="left"/>
        <Key android:codes="32" android:keyIcon="@drawable/ic_space" android:keyWidth="53.5%p"
            android:isRepeatable="true"/>
        <Key android:codes="-2" android:keyIcon="@drawable/ic_caps_black" android:keyWidth="13%p"
            android:isModifier="true" android:isSticky="true"  />
        <Key android:codes="10" android:keyIcon="@drawable/ic_enter" android:keyWidth="16%p"
            android:keyEdgeFlags="right"/>

    </Row>
</Keyboard>
